{
  "name": "homebridge-qbittorrent-plugin",
  "displayName": "qBittorrent",
  "type": "module",
  "version": "2.0.0",
  "private": false,
  "description": "A Homebridge plugin that exposes a HomeKit switch for each qBittorrent server, toggling its alternative speed limits.",
  "author": "Christian Rauchenwald",
  "license": "Apache-2.0",
  "homepage": "https://github.com/RauchenwaldC/homebridge-qbittorrent-plugin?tab=readme-ov-file#qbittorrent-homebridge-plugin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RauchenwaldC/homebridge-qbittorrent-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/RauchenwaldC/homebridge-qbittorrent-plugin/issues"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/RauchenwaldC"
    },
    {
      "type": "paypal",
      "url": "https://paypal.me/ChristianRauchenwald"
    }
  ],
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "homebridge",
    "qbittorrent",
    "torrent",
    "speed-limits",
    "bandwidth"
  ],
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run build && node --test \"test/**/*.test.ts\"",
    "typecheck:test": "tsc --project tsconfig.test.json",
    "check": "npm run lint && npm run test && npm run typecheck:test",
    "prepublishOnly": "npm run check",
    "watch": "npm run build && npm link && nodemon"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.0",
    "homebridge": "^2.3.1",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
